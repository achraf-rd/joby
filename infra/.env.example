# Copy to infra/.env, then: docker compose -f infra/docker-compose.yml up --build
# Generate secrets with: openssl rand -base64 48
POSTGRES_PASSWORD=change-me
INTERNAL_HMAC_SECRET=change-me
JWT_ACCESS_SECRET=change-me
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me

# Host port for Postgres (change if 5432 is taken).
POSTGRES_PORT=5432
