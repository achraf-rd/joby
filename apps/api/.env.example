# Copy to apps/api/.env for local development.
PORT=3000
DATABASE_URL=postgresql://joby:joby@localhost:5432/joby
# Origin allowed by CORS (the web app). Credentials are allowed for the refresh cookie.
WEB_ORIGIN=http://localhost:5173
# Internal base URL of the Python agents-api (private network only).
AGENTS_API_URL=http://localhost:8000
# HMAC secret shared with the agent service for signed callbacks (ARCHITECTURE §5.2). One per environment.
INTERNAL_HMAC_SECRET=change-me
# Auth secrets (ARCHITECTURE §7.1). Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me
